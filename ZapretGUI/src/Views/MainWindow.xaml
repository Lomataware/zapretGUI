<Window x:Class="ZapretGUI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:ZapretGUI.Views"
        Title="ZapretGUI — обход блокировок (zapret/flowseal + byedpi)"
        Width="1100" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        FontFamily="{StaticResource AppFont}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ NAVIGATION PANE (Win11) ============ -->
        <Border Grid.Column="0" Background="{DynamicResource LayerBrush}" Padding="8,14,8,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="12,0,12,18">
                    <TextBlock Text="&#xE702;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="ZapretGUI" Style="{StaticResource TitleText}" FontSize="20" Margin="0,6,0,0"/>
                    <TextBlock Text="Обход блокировок РФ" Style="{StaticResource CaptionText}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,4">
                    <!-- статус движка внизу навигации -->
                    <Border Style="{StaticResource Card}" Padding="12,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,8,0"
                                         Fill="{Binding EngineStateColorKey, Converter={StaticResource BrushByKey}}"/>
                                <TextBlock Text="{Binding EngineStateText}" Style="{StaticResource BodyText}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="{Binding AdminInfo}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="v1.2 · zapret (flowseal) + byedpi" Style="{StaticResource CaptionText}"
                               FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel>
                    <RadioButton Style="{StaticResource TabHeader}" Tag="&#xE80F;" Content="Главная"
                                 IsChecked="{Binding SelectedPage, Mode=TwoWay, Converter={StaticResource IntEq}, ConverterParameter=0}"/>
                    <RadioButton Style="{StaticResource TabHeader}" Tag="&#xE713;" Content="Настройки движка"
                                 IsChecked="{Binding SelectedPage, Mode=TwoWay, Converter={StaticResource IntEq}, ConverterParameter=1}"/>
                    <RadioButton Style="{StaticResource TabHeader}" Tag="&#xE8A5;" Content="Списки и профили"
                                 IsChecked="{Binding SelectedPage, Mode=TwoWay, Converter={StaticResource IntEq}, ConverterParameter=2}"/>
                    <RadioButton Style="{StaticResource TabHeader}" Tag="&#xE9D9;" Content="Тест блокировок"
                                 IsChecked="{Binding SelectedPage, Mode=TwoWay, Converter={StaticResource IntEq}, ConverterParameter=3}"/>
                    <RadioButton Style="{StaticResource TabHeader}" Tag="&#xE895;" Content="Обновление"
                                 IsChecked="{Binding SelectedPage, Mode=TwoWay, Converter={StaticResource IntEq}, ConverterParameter=4}"/>
                    <RadioButton Style="{StaticResource TabHeader}" Tag="&#xE7E8;" Content="Приложение"
                                 IsChecked="{Binding SelectedPage, Mode=TwoWay, Converter={StaticResource IntEq}, ConverterParameter=5}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ CONTENT ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding CurrentPageTitle}" Style="{StaticResource TitleText}"
                       Margin="36,22,36,6"/>

            <Grid Grid.Row="1" Margin="{StaticResource PageMargin}">
                <v:HomePage Visibility="{Binding SelectedPage, Converter={StaticResource IntEqV}, ConverterParameter=0}"/>
                <v:EngineSettingsPage Visibility="{Binding SelectedPage, Converter={StaticResource IntEqV}, ConverterParameter=1}"/>
                <v:ListsPage Visibility="{Binding SelectedPage, Converter={StaticResource IntEqV}, ConverterParameter=2}"/>
                <v:TestsPage Visibility="{Binding SelectedPage, Converter={StaticResource IntEqV}, ConverterParameter=3}"/>
                <v:UpdatePage Visibility="{Binding SelectedPage, Converter={StaticResource IntEqV}, ConverterParameter=4}"/>
                <v:AppSettingsPage Visibility="{Binding SelectedPage, Converter={StaticResource IntEqV}, ConverterParameter=5}"/>
            </Grid>

            <!-- строка состояния -->
            <Border Grid.Row="2" Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}"
                    BorderThickness="0,1,0,0" Padding="16,6">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ListCountsInfo}" Style="{StaticResource CaptionText}" FontSize="11"/>
                    <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource CaptionText}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
