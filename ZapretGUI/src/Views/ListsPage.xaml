<UserControl x:Class="ZapretGUI.Views.ListsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,0,0,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource CaptionText}" Margin="2,0,0,8"
                   Text="Правятся user-файлы (list-general-user.txt / list-exclude-user.txt / ipset-user.txt) — они НЕ перезаписываются при обновлении баз."/>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    <Setter Property="Padding" Value="12,6"/>
                </Style>
            </TabControl.Resources>
            <TabItem Header="Домены (обходить блокировку)">
                <TextBox Text="{Binding DomainsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" FontFamily="{StaticResource MonoFont}" FontSize="12"
                         VerticalScrollBarVisibility="Auto" MinHeight="300" Margin="0,8,0,0"/>
            </TabItem>
            <TabItem Header="Исключения доменов">
                <TextBox Text="{Binding ExcludesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" FontFamily="{StaticResource MonoFont}" FontSize="12"
                         VerticalScrollBarVisibility="Auto" MinHeight="300" Margin="0,8,0,0"/>
            </TabItem>
            <TabItem Header="IP-сети (ipset)">
                <TextBox Text="{Binding IpsetText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" FontFamily="{StaticResource MonoFont}" FontSize="12"
                         VerticalScrollBarVisibility="Auto" MinHeight="300" Margin="0,8,0,0"/>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="2,10,2,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="💾 Сохранить списки" Style="{StaticResource AccentButton}" Command="{Binding SaveListsCommand}" Margin="0,0,8,0"/>
                <Button Content="⟲ Перечитать с диска" Style="{StaticResource DefaultButton}" Command="{Binding ReloadListsCommand}"/>
            </StackPanel>
            <TextBlock Text="{Binding ListCountsInfo}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</UserControl>
