<UserControl x:Class="ZapretGUI.Controls.VerdictBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
        <Border.Background>
            <Binding Path="BackgroundKey" RelativeSource="{RelativeSource Self}" Converter="{StaticResource BrushByKey}"/>
        </Border.Background>
        <TextBlock Text="{Binding Text, RelativeSource={RelativeSource Self}}" FontSize="12" FontWeight="SemiBold"
                   Foreground="{Binding ForegroundKey, RelativeSource={RelativeSource Self}, Converter={StaticResource BrushByKey}}"/>
    </Border>
</UserControl>
