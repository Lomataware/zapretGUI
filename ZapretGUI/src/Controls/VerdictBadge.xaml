<UserControl x:Class="ZapretGUI.Controls.VerdictBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Привязки идут к DependencyProperty родительского UserControl, а не к самому Border/TextBlock -->
    <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center"
            Background="{Binding BackgroundKey, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BrushByKey}}">
        <TextBlock Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   FontSize="12" FontWeight="SemiBold"
                   Foreground="{Binding ForegroundKey, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BrushByKey}}"/>
    </Border>
</UserControl>
